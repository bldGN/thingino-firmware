# NAME: Petcube Cam 360 / Meari Speed-27S (T31LC, MIS2009, ATBM6032)
# FRAG: soc-xburst1 core
# STATUS: EXPERIMENTAL / not yet hardware-verified.
#   SoC T31LC, 64MB RAM (stock mem=40M+rmem=24M), 16MB SPI NOR. Board SPEED27S-T10MB-MIS3.
#   Sensor MIS2009 MIPI (chip id 0x2008 @ i2c 0x30); driver ported from stock
#   vendor sensor_mis2009_t31.ko into ingenic-sdk common/sensor/t31/mis2009.c.
#   WiFi ATBM6032 on USB (stock reports atbm603x, VID:PID 007a:8888).
#   GPIOs seeded from petcube_c401a (same ODM design; usb_en/mmc_cd/speaker/button
#   match this unit's stock boot log) -- verify ircut/ir850/white on hardware.
#   SECUREBOOP modulus inherited from petcube_c401a image, which boots on this unit.
BR2_AVPU_CLK_600MHZ=y
BR2_INGENIC_SOC_MODEL="t31lc"
BR2_PACKAGE_THINGINO_KOPT_MMC0=y
BR2_PACKAGE_THINGINO_KOPT_MMC0_PB_4BIT=y
BR2_PACKAGE_WIFI=y
BR2_PACKAGE_WIFI_ATBM6032=y
BR2_SENSOR_1_NAME="mis2009"
BR2_PACKAGE_THINGINO_SECUREBOOP=y
BR2_PACKAGE_THINGINO_SECUREBOOP_T31_MODULUS=""
BR2_THINGINO_AUDIO=y
BR2_THINGINO_BUTTON=y
BR2_THINGINO_LED_W_GPIO=50
BR2_THINGINO_RMEM_MB=24
BR2_THINGINO_SDCARD=y
FLASH_SIZE_MB=16
