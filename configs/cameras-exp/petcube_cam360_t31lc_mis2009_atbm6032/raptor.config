# Petcube Cam 360 (T31LC, MIS2009, ATBM6032)
#
# The stock tx-isp blob does not publish /proc/jz/sensor/sensor0 for the
# mis2009, so raptor's runtime sensor auto-detect finds nothing and the
# stream never starts. Pin the [sensor] block at build time so the image
# streams out of the box with no manual `raptorctl config set sensor ...`.
#
# fps=25 matches the sensor init table (total_height/VTS 1350 @ 25fps); a
# 30fps config here causes a rolling frame. i2c addr 0x30 on adapter 0.
RAPTOR_SENSOR_NAME="mis2009"
RAPTOR_SENSOR_I2C_ADDR="0x30"
RAPTOR_SENSOR_I2C_ADAPTER="0"
RAPTOR_SENSOR_FPS="25"
